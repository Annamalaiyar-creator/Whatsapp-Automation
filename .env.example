# Copy to .env and fill in. Never commit .env.

PORT=4600

# The app connects as a limited role so Postgres row-level security keeps every client company's data apart.
DATABASE_URL=postgres://wa_app:CHANGE_ME@localhost:5432/wa_automation
# A superuser connection, used only by db:setup and db:migrate. Local Homebrew Postgres uses the /tmp socket.
DATABASE_ADMIN_URL=postgres:///postgres?host=/tmp
# Password that db:setup gives the wa_app role. Must match DATABASE_URL.
APP_DB_PASSWORD=CHANGE_ME

# Database used by the automated tests (created and wiped by the tests).
TEST_DATABASE_NAME=wa_automation_test

# First console login, created by db:seed (development only).
DEV_OWNER_EMAIL=owner@example.test
DEV_OWNER_PASSWORD=CHANGE_ME

SESSION_TTL_HOURS=12
# How often the escalation check runs, in seconds.
ESCALATION_TICK_SECONDS=60
